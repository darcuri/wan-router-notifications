# deploy/terraform/terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in your values

region           = "us-ashburn-1"
compartment_ocid = "ocid1.compartment.oc1..your-compartment-ocid"
subnet_ocid      = "ocid1.subnet.oc1..your-subnet-ocid"

# SSH key will be passed via command line:
# terraform apply -var="ssh_public_key=$(cat ~/id_ed25519.pub)"

instance_ocpus     = 1
instance_memory_gb = 6

# --- Out of capacity workarounds ---

# Try a different availability domain (0, 1, or 2):
# availability_domain_index = 1

# Switch to x86 micro (always-free, 1 OCPU / 1 GB, no shape_config needed):
# instance_shape = "VM.Standard.E2.1.Micro"

# Alternative free-tier regions to try if capacity is exhausted:
# region = "us-phoenix-1"
# region = "eu-amsterdam-1"
# region = "ap-mumbai-1"
# region = "uk-london-1"
# region = "sa-saopaulo-1"
